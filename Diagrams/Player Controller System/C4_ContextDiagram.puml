@startuml PCS_HighLevel_Component

!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml

title Player Controller System - High-Level Component Diagram

Container_Boundary(pcs, "Player Controller System") {

    Component(input, "Input Handling", "Unity Input System", "Reads player input and forwards actions to gameplay systems")

    Component(movement, "Movement System", "Unity Component", "Handles movement, sprinting, jumping, gravity, and movement states")

    Component(interaction, "Interaction System", "Unity Component", "Detects and invokes interactable objects in the environment")

    Component(camera, "Camera & Vision System", "Cinemachine / Unity Component", "Binds camera to the local player and handles camera-related behaviour")

    Component(abilities, "Ability System", "Unity Component", "Handles role-specific abilities such as Cat Vision")

    Component(audio, "Audio Feedback System", "Unity Component", "Plays footsteps, jumps, dialogue, and interaction feedback")

    Component(role, "Role Handling", "NetworkBehaviour", "Assigns and exposes player role state such as Human or Cat")

    Component(visual, "Visual Feedback System", "Unity Component", "Handles model visibility, fading, and role-based visual feedback")

    Component(network, "Multiplayer Synchronization", "Unity Netcode", "Synchronizes player state and role-specific behaviour across clients")
}

Rel(input, movement, "Triggers movement actions")
Rel(input, interaction, "Triggers interaction input")
Rel(input, abilities, "Triggers ability input")

Rel(role, abilities, "Determines available abilities")
Rel(role, visual, "Controls role-based visuals")
Rel(role, interaction, "Restricts role-specific interactions")

Rel(movement, audio, "Raises movement feedback events")
Rel(interaction, audio, "Raises interaction feedback events")
Rel(abilities, visual, "Updates ability visual effects")

Rel(camera, movement, "Supports camera-relative movement")
Rel(network, role, "Synchronizes role state")
Rel(network, movement, "Synchronizes player transform/state")
Rel(network, interaction, "Synchronizes interaction results")

@enduml