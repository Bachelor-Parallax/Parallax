@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml

SHOW_PERSON_OUTLINE()

title [Component] Player Controller System

Container_Boundary(pcs, "Player Controller System") {

    Component(roleController, "RoleController", "NetworkBehaviour", "Assigns player roles and exposes role-specific state")

    Component(movementController, "PlayerMovementController", "Unity Component", "Coordinates movement input and forwards it to movement-related systems")

    Component(playerMovement, "PlayerMovement", "Unity Component", "Handles movement, sprinting, gravity, rotation and movement locking")

    Component(jumpAbility, "PlayerJumpAbility", "Unity Component", "Handles jump input and role-restricted jumping behaviour")

    Component(catVisionInput, "PlayerCatVisionInput", "Unity Component", "Receives CatVision input from the local player")

    Component(catVision, "PlayerCatVision", "Unity Component", "Handles cat-specific vision mode, highlighting, movement slow and camera adjustments")

    Component(interactor, "Interactor", "Unity Component", "Detects nearby interactable objects and invokes interaction logic")

    Component(promptUI, "InteractionPromptUI", "Unity UI", "Displays contextual interaction prompts")

    Component(audioEvents, "PlayerAudioEvents", "Unity Component", "Exposes player audio events such as jump, footsteps and character sounds")

    Component(audioController, "PlayerAudioController", "Unity Component", "Routes player audio events to the correct audio sources")

    Component(footstepAudio, "PlayerFootstepAudio", "Unity Component", "Triggers footstep feedback based on movement state")

    Component(rotation, "PlayerRotation", "Unity Component", "Handles player rotation based on movement and camera direction")

    Component(cameraBinder, "SceneCameraBinder", "Unity Component", "Binds the scene camera to the locally owned player object")

    Component(camFade, "PlayerCamFade", "Unity Component", "Fades player visuals when the camera is too close")

    Component(interactables, "Interactables", "Gameplay Components", "Buttons, keys, doors, boxes, rotating objects, lights and activation pads")
}

Rel(roleController, playerMovement, "Applies role-specific movement values")
Rel(roleController, jumpAbility, "Enables or restricts role-specific jumping")
Rel(roleController, catVision, "Enables cat-specific ability")
Rel(roleController, interactor, "Supports role-based interaction checks")
Rel(roleController, audioController, "Provides current role for sound selection")

Rel(movementController, playerMovement, "Forwards movement and sprint input")
Rel(movementController, jumpAbility, "Forwards jump input")
Rel(movementController, rotation, "Coordinates movement-facing direction")

Rel(playerMovement, rotation, "Uses rotation for movement direction")
Rel(playerMovement, footstepAudio, "Provides movement state for footsteps")
Rel(playerMovement, audioEvents, "Triggers movement-related audio events")

Rel(jumpAbility, playerMovement, "Uses grounded state and vertical velocity")
Rel(jumpAbility, audioEvents, "Triggers jump audio event")

Rel(catVisionInput, catVision, "Toggles vision mode")
Rel(catVision, playerMovement, "Applies movement slow during vision mode")
Rel(catVision, cameraBinder, "Modifies camera behaviour during vision mode")
Rel(catVision, interactables, "Highlights vision targets")

Rel(interactor, interactables, "Detects and interacts with")
Rel(interactor, promptUI, "Updates interaction prompt")

Rel(footstepAudio, audioEvents, "Triggers footstep audio events")
Rel(audioEvents, audioController, "Notifies audio controller")
Rel(audioController, characterSound, "Selects and plays role-based sounds")

Rel(cameraBinder, camFade, "Supports local camera visibility handling")

@enduml