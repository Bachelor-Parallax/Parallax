@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml

SHOW_PERSON_OUTLINE()

'skinparam Linetype ortho

title [Component] Parallax - Player Controller System

System_Boundary(parallax, "Parallax") {

    Container_Boundary(pcs, "Player Controller System") {

        Component(roleController, "RoleController", "NetworkBehaviour", "Assigns player roles and exposes role-specific state")

        Component(movementController, "PlayerMovementController", "Unity Component", "Coordinates movement input")

        Component(playerMovement, "PlayerMovement", "Unity Component", "Handles movement, sprinting, gravity and movement locking")

        Component(playerRotation, "PlayerRotation", "Unity Component", "Handles player rotation based on camera and movement direction")

        Component(jumpAbility, "PlayerJumpAbility", "Unity Component", "Handles role-restricted jumping")

        Component(interactor, "Interactor", "Unity Component", "Detects and invokes interactable objects")

        Component(catVisionInput, "PlayerCatVisionInput", "Unity Component", "Receives CatVision input")

        Component(catVision, "PlayerCatVision", "Unity Component", "Handles CatVision, object highlighting and movement slow")

        Component(promptUI, "InteractionPromptUI", "Unity UI", "Displays interaction prompts")

        Component(audioEvents, "PlayerAudioEvents", "Unity Component", "Exposes player audio events")

        Component(audioController, "PlayerAudioController", "Unity Component", "Routes player audio feedback")

        Component(footstepAudio, "PlayerFootstepAudio", "Unity Component", "Triggers footstep feedback from movement state")

        Component(cameraBinder, "SceneCameraBinder", "Unity Component", "Binds the camera to the local player")

        Component(camFade, "PlayerCamFade", "Unity Component", "Fades player visuals near the camera")

        Component(interactables, "Interactables", "Gameplay Components", "Buttons, keys, doors, boxes, lights and activation pads")
    }

    Container(multiplayer, "Multiplayer System", "Unity/NGO", "Synchronizes players and gameplay state")
    Container(settings, "Settings System", "Unity Component", "Manages player settings")
}

Rel(multiplayer, roleController, "Synchronizes player roles")
Rel(multiplayer, interactables, "Synchronizes interaction and activation states")

Rel(settings, movementController, "Applies input and camera sensitivity")
Rel(settings, audioController, "Applies audio settings")

Rel(roleController, playerMovement, "Applies role-specific movement values")
Rel(roleController, jumpAbility, "Enables or restricts jumping")
Rel(roleController, catVision, "Enables cat-specific ability")
Rel(roleController, interactor, "Supports role-based interaction checks")
Rel(roleController, audioController, "Provides current role")

Rel(movementController, playerMovement, "Forwards movement and sprint input")
Rel(movementController, jumpAbility, "Forwards jump input")
Rel(movementController, playerRotation, "Coordinates movement direction")

Rel(playerMovement, playerRotation, "Uses rotation for movement direction")
Rel(playerMovement, footstepAudio, "Provides movement state")
Rel(playerMovement, audioEvents, "Triggers movement audio events")

Rel(jumpAbility, playerMovement, "Uses grounded state and vertical velocity")
Rel(jumpAbility, audioEvents, "Triggers jump audio event")

Rel(interactor, interactables, "Interacts with")
Rel(interactor, promptUI, "Updates interaction prompts")
Rel(interactor, audioEvents, "Triggers interaction audio event")

Rel(catVisionInput, catVision, "Toggles vision mode")
Rel(catVision, playerMovement, "Applies movement slow")
Rel(catVision, cameraBinder, "Adjusts camera behaviour")
Rel(catVision, interactables, "Highlights vision targets")

Rel(footstepAudio, audioEvents, "Triggers footstep events")
Rel(audioEvents, audioController, "Notifies audio controller")

Rel(cameraBinder, camFade, "Supports local camera visibility handling")

@enduml