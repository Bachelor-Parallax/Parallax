@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml

SHOW_PERSON_OUTLINE()

Container_Boundary(audio, "Audio System") {

    Component(footstepAudio, "PlayerFootstepAudio", "Unity Component", "Triggers footstep feedback based on movement state")

    Component(audioEvents, "PlayerAudioEvents", "Unity Component", "Exposes player audio events")

    Component(characterSound, "CharacterSound", "Unity Component", "Handles playback of player sound effects and character audio")
}

Rel(footstepAudio, audioEvents, "Triggers footstep events")

Rel(audioEvents, characterSound, "Provides audio events")

@enduml